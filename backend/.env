# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for the BIM Repository Authentication Backend
# NEVER commit this file to version control — add it to .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# JWT secret key — used to sign all tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=10957a88d4fd5e207e59c749bf54f3c2d2f50adaa1441e5ae22302f20a395e4a0af79e5a98a5962cf3bc5ae481c79117061f6bd78477b4f8dafdddb32ef6da8c

# JWT algorithm (HS256 = HMAC-SHA256 — fast and widely supported)
ALGORITHM=HS256

# Expiration of the short-lived "pre-2FA" token (minutes)
# 3 min = ~6 TOTP cycles — enough to scan QR + type the code, tight enough to not survive a logout
TEMP_TOKEN_EXPIRE_MINUTES=3

# Expiration of the final JWT after successful 2FA (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL connection string
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://liandralourenco@localhost:5432/bim_auth

# Issuer name shown inside the TOTP authenticator app (e.g. Google Authenticator)
TOTP_ISSUER_NAME=BIM Repository
