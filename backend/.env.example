# ─────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no repositório.
# ─────────────────────────────────────────────────────────────────────────────

# JWT — gere com: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_128_CHARS_HEX
ALGORITHM=HS256
TEMP_TOKEN_EXPIRE_MINUTES=3
ACCESS_TOKEN_EXPIRE_MINUTES=60
TOTP_ISSUER_NAME=BIM Repository

# Banco de dados — PostgreSQL no Neon (https://neon.tech)
# Formato: postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Supabase Storage (https://supabase.com)
# SUPABASE_URL: encontrado em Project Settings → API → Project URL
# SUPABASE_SERVICE_KEY: encontrado em Project Settings → API → service_role (secret)
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=SEU_SERVICE_ROLE_KEY
STORAGE_BUCKET=bim-files

# CORS — URL do frontend no Vercel (sem barra no final)
# Em desenvolvimento local, mantenha como *
ALLOWED_ORIGINS=https://SEU_APP.vercel.app
